// Pasos de nuestra metodología de trabajo
const steps = [
  { num: "01", name: "Descubrimiento", desc: "Analizamos tus procesos actuales y necesidades críticas para definir el alcance óptimo." },
  { num: "02", name: "Arquitectura & UX", desc: "Diseñamos la estructura técnica escalable y los prototipos interactivos premium." },
  { num: "03", name: "Desarrollo Ágil", desc: "Programamos con código limpio, pruebas exhaustivas y entregas iterativas continuas." },
  { num: "04", name: "Optimización & Lanzamiento", desc: "Desplegamos en entornos cloud de alto rendimiento y configuramos analítica." }
