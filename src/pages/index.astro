// Testimonios de clientes reales
const testimonials = [
  {
    name: "Dr. Carlos Mendoza",
    role: "Director de GINEP Clínica",
    text: "La digitalización de nuestro portal médico de la mano de Capitask transformó completamente nuestra gestión de pacientes. Su soporte y código limpio son inigualables.",
    avatarSvg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-orange-500/70"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>`
  },
  {
    name: "Alberto Silva",
    role: "Administrador de Rulemanes Industriales",
    text: "Pusieron en marcha nuestro catálogo industrial en Uruguay en tiempo récord. El buscador inteligente funciona al instante y la velocidad de carga es increíble.",
    avatarSvg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-orange-500/70"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>`
  },
  {
    name: "Mariana Ortega",
    role: "Co-fundadora de Numisfila",
    text: "Capitask entendió perfectamente lo que buscábamos. Nuestra base de datos y la velocidad del catálogo son impecables. Recomendados 100%.",
    avatarSvg: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-orange-500/70"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>`
  }
];

// Stack Tecnológico
const techStack = [
  "Laravel", "PHP", "Vue.js", "Nuxt.js", "PostgreSQL", "Supabase", "MySQL", "APIs RESTful", "HTML", "CSS", "JavaScript", "Bootstrap"
];

// Preguntas frecuentes
const faqs = [
  { q: "¿En cuánto tiempo entregan un MVP?", a: "Típicamente entre 4 a 6 semanas, dependiendo de la complejidad de la arquitectura y las integraciones requeridas." },
  { q: "¿Cómo aseguran la escalabilidad del software?", a: "Diseñamos microservicios con arquitecturas serverless o contenedores Docker en plataformas cloud como AWS y Google Cloud, garantizando redundancia y auto-escalado." },
  { q: "¿Qué tecnologías utilizan principalmente?", a: "Nuestro stack principal incluye Astro y Next.js para Frontend, Node.js, Python y Go en Backend, y Postgres, Redis y Clickhouse para persistencia de datos." }
