---

<Layout title="Capitask | Desarrollo de Software Extraordinario y Automatización IA">
	<!-- Noise Background global -->
	<div class="fixed inset-0 bg-noise z-[-2] pointer-events-none opacity-40"></div>

	<!-- Navbar Premium (Liquid Glass) -->
	<header class="fixed top-0 left-0 w-full z-50 px-6 py-6 transition-all duration-300">
		<div class="max-w-7xl mx-auto glass-card rounded-2xl px-8 py-4 flex justify-between items-center border border-white/10 bg-slate-950/30 backdrop-blur-2xl">
			<!-- Logo Capitask con logoss.png -->
			<a href="#" class="flex items-center gap-3 font-extrabold text-2xl tracking-tight text-white group">
				<img src="/logoss.png" alt="Capitask Logo" class="h-10 w-auto object-contain filter drop-shadow-[0_0_8px_rgba(249,115,22,0.4)] transition-transform duration-300 group-hover:rotate-12" />
			</a>

			<nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
				<a href="#nosotros" class="hover:text-orange-400 transition-colors duration-200">Sobre Nosotros</a>
				<a href="#servicios" class="hover:text-orange-400 transition-colors duration-200">Servicios</a>
				<a href="#proyectos" class="hover:text-orange-400 transition-colors duration-200">Nuestros Proyectos</a>
				<a href="#metodologia" class="hover:text-orange-400 transition-colors duration-200">Método</a>
				<a href="#faqs" class="hover:text-orange-400 transition-colors duration-200">FAQs</a>
				<a href="#contacto" class="hover:text-orange-400 transition-colors duration-200">Contacto</a>
			</nav>

			<div class="flex items-center gap-4">
				<a href="#contacto" class="btn-shine-container px-6 py-3 rounded-xl bg-orange-500 text-slate-950 font-bold text-sm hover:shadow-[0_0_30px_rgba(249,115,22,0.45)] hover:scale-[1.03] active:scale-95 transition-all duration-300 ease-out">
					<span class="btn-shine-effect relative z-10">Iniciar Proyecto</span>
				</a>
			</div>
		</div>
	</header>

	<main class="max-w-7xl mx-auto px-6 pt-40 pb-24 flex flex-col gap-40">
		
		<!-- Hero Section Premium + Editor de Código -->
		<section class="min-h-[85vh] grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative py-12 animate-on-scroll">
			<div class="absolute top-[10%] w-[300px] h-[300px] bg-orange-500/5 rounded-full blur-[80px] pointer-events-none"></div>

			<!-- Columna Izquierda: Información -->
			<div class="lg:col-span-7 flex flex-col items-start text-left">
				<div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full glass-card text-xs text-orange-400 mb-8 border border-orange-500/30 font-medium bg-orange-500/5 shadow-[0_0_15px_rgba(249,115,22,0.1)]">
					<span class="relative flex h-2 w-2">
					  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-400 opacity-75"></span>
					  <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
					</span>
					Desarrollo de Software de Alta Gama
				</div>
				
				<h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight mb-8 leading-[1.05] text-white">
					Ingeniería de Software de <br />
					<span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-400 to-orange-600 drop-shadow-[0_2px_20px_rgba(249,115,22,0.2)]">
						Siguiente Generación
					</span>
				</h1>
				
				<p class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed font-light">
					Soluciones web avanzadas y aplicaciones móviles de alto rendimiento. Especialistas en Laravel, Vue, Nuxt e integración de APIs.
				</p>
				
				<div class="flex flex-col sm:flex-row gap-5 z-10 w-full sm:w-auto">
					<a href="#contacto" class="btn-shine-container text-center px-8 py-4 rounded-xl bg-gradient-to-r from-orange-500 via-orange-600 to-amber-600 text-white font-extrabold hover:shadow-[0_0_35px_rgba(249,115,22,0.6)] hover:scale-[1.05] active:scale-95 transition-all duration-300">
						<span class="btn-shine-effect">Cotizar Proyecto</span>
					</a>
					<a href="#proyectos" class="px-8 py-4 rounded-xl text-center glass-card text-slate-200 font-semibold border border-white/10 hover:glass-card-hover hover:scale-[1.05] active:scale-95 transition-all duration-300">
						Ver Casos de Éxito
					</a>
				</div>
			</div>

			<!-- Columna Derecha: Editor de Código Premium con Efecto Float -->
			<div class="lg:col-span-5 w-full flex justify-center animate-float">
				<div class="w-full max-w-[500px] glass-card rounded-2xl border border-white/10 shadow-2xl overflow-hidden relative group/editor">
					<div class="absolute inset-0 bg-gradient-to-br from-orange-500/5 to-transparent pointer-events-none"></div>
					<div class="flex justify-between items-center bg-slate-900/60 px-4 py-3 border-b border-white/5">
						<div class="flex gap-2">
							<span class="w-3 h-3 rounded-full bg-red-500/70"></span>
							<span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
							<span class="w-3 h-3 rounded-full bg-green-500/70"></span>
						</div>
						<span class="text-xs font-mono text-slate-400">src/components/Capitask.ts</span>
						<span class="w-4 h-4"></span>
					</div>
					<div class="p-6 font-mono text-xs md:text-sm text-slate-300 overflow-x-auto leading-relaxed bg-slate-950/40">
						<div><span class="text-pink-500">import</span> &#123; <span class="text-blue-400">Laravel</span>, <span class="text-blue-400">Vue</span>, <span class="text-blue-400">Nuxt</span> &#125; <span class="text-pink-500">from</span> <span class="text-emerald-400">'@capitask/core'</span>;</div>
						<div class="text-slate-600">// Configuración de Capitask Engine</div>
						<div><span class="text-pink-500">const</span> <span class="text-yellow-400">company</span> = &#123;</div>
						<div class="pl-4">name: <span class="text-emerald-400">"Capitask"</span>,</div>
						<div class="pl-4">focus: <span class="text-emerald-400">"Desarrollo Premium"</span>,</div>
						<div class="pl-4">databases: [<span class="text-emerald-400">"PostgreSQL"</span>, <span class="text-emerald-400">"MySQL"</span>, <span class="text-emerald-400">"Supabase"</span>]</div>
						<div>&#125;;</div>
						<div class="my-2"></div>
						<div><span class="text-pink-500">async function</span> <span class="text-blue-400">desplegar</span>() &#123;</div>
						<div class="pl-4"><span class="text-pink-500">await</span> <span class="text-blue-400">Laravel</span>.<span class="text-yellow-400">buildAPIs</span>();</div>
						<div class="pl-4"><span class="text-pink-500">await</span> <span class="text-blue-400">Vue</span>.<span class="text-yellow-400">renderLiquidGlass</span>();</div>
						<div class="pl-4"><span class="text-blue-400">console</span>.<span class="text-yellow-400">log</span>(<span class="text-emerald-400">"🚀 Plataforma en línea!"</span>);</div>
						<div>&#125;</div>
						<div class="my-2"></div>
						<div class="text-orange-500 font-bold animate-pulse">&gt; desplegar();</div>
					</div>
				</div>
			</div>

			<!-- Indicador animado de scroll -->
			<div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 opacity-60">
				<span class="text-[10px] font-mono tracking-widest text-slate-400 uppercase">Scroll</span>
				<div class="w-5 h-8 rounded-full border border-slate-500 flex justify-center p-1.5">
					<div class="w-1 h-1.5 rounded-full bg-orange-500 animate-scroll-dot"></div>
				</div>
			</div>
		</section>

		<!-- Quick Stats Grid -->
		<section class="grid grid-cols-2 md:grid-cols-4 gap-6 w-full max-w-7xl mx-auto -mt-20 animate-on-scroll">
			{[
				{ val: "99.9%", desc: "Disponibilidad SLA" },
				{ val: "10x", desc: "Velocidad de Carga" },
				{ val: "+80%", desc: "Productividad con IA" },
				{ val: "+20", desc: "Sistemas Integrados" }
			].map(stat => (
				<div class="glass-card px-6 py-8 rounded-2xl hover:glass-card-hover transition-all duration-300 border border-white/5 bg-slate-900/10 text-center">
					<div class="text-3xl md:text-4xl font-extrabold text-white mb-2 bg-gradient-to-r from-orange-400 to-amber-500 bg-clip-text text-transparent">{stat.val}</div>
					<div class="text-xs md:text-sm text-slate-400 font-medium tracking-wide uppercase">{stat.desc}</div>
				</div>
			))}
		</section>

		<!-- Sección: Sobre Nosotros, Misión, Visión -->
		<section id="nosotros" class="scroll-mt-28 animate-on-scroll">
			<div class="text-center max-w-3xl mx-auto mb-20">
				<div class="text-orange-500 font-bold text-xs uppercase tracking-widest mb-3">Nuestra Esencia</div>
				<h2 class="text-3xl md:text-5xl font-black tracking-tight text-white mb-4">
					Sobre Nosotros
				</h2>
				<p class="text-slate-400 text-lg">
					Conoce el propósito, dirección y valores que guían cada uno de nuestros desarrollos.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<!-- Quiénes Somos -->
				<div class="glass-card p-8 rounded-3xl hover:glass-card-hover transition-all duration-500 relative overflow-hidden group">
					<div class="absolute -top-12 -right-12 w-24 h-24 bg-orange-500/5 rounded-full blur-xl"></div>
					<div class="text-orange-500 mb-6 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.109A9.342 9.342 0 0 1 12.24 21c-1.11-.274-2.143-.754-3.045-1.416M19.5 7.5c.047.58-.195 1.17-.6 1.6m.6-1.6a3 3 0 0 0-3-3m3 3a3 3 0 0 1-3 3m0 0a3 3 0 0 1-3-3m3 3v-.375c0-1.11-.285-2.16-.786-3.07m-.786 3.07a9.37 9.37 0 0 1-4.093-3.414M3 16.275a8.82 8.82 0 0 0 5.25 1.63M3 16.275a8.82 8.82 0 0 1 5.25-1.63m-5.25 0A8.82 8.82 0 0 1 3 13.025m0 3.25a8.82 8.82 0 0 0 5.25 1.63" />
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-white mb-4 group-hover:text-orange-400 transition-colors">¿Quiénes Somos?</h3>
					<p class="text-slate-400 leading-relaxed text-sm">
						Somos un equipo especializado en el desarrollo e integración de software a medida, enfocados en prestigiosas soluciones web fullstack, APIs de alta velocidad con Laravel y aplicaciones móviles responsivas. Trabajamos codo con codo con empresas para materializar sus ideas.
					</p>
				</div>

				<!-- Misión -->
				<div class="glass-card p-8 rounded-3xl hover:glass-card-hover transition-all duration-500 relative overflow-hidden group">
					<div class="absolute -top-12 -right-12 w-24 h-24 bg-orange-500/5 rounded-full blur-xl"></div>
					<div class="text-orange-500 mb-6 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
						</svg>
					</div>
					<h3 class="text-2xl font-bold text-white mb-4 group-hover:text-orange-400 transition-colors">Nuestra Misión</h3>
					<p class="text-slate-400 leading-relaxed text-sm">
						Proveer soluciones tecnológicas robustas, optimizadas y funcionales. Diseñamos con código limpio, bases de datos eficientes como PostgreSQL y MySQL, y la versatilidad de frameworks líderes (Laravel y Vue.js) con el fin de simplificar procesos y automatizar flujos.
					</p>
				</div>

				<!-- Visión -->
				<div class="glass-card p-8 rounded-3xl hover:glass-card-hover transition-all duration-500 relative overflow-hidden group">
					<div class="absolute -top-12 -right-12 w-24 h-24 bg-orange-500/5 rounded-full blur-xl"></div>
