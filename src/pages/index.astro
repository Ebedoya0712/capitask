			<span class="animate-ping absolute inset-0 rounded-full bg-orange-400/20 opacity-75"></span>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 stroke-slate-950 fill-none" viewBox="0 0 24 24" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
			</svg>
		</button>
	</div>

	<!-- Lógica JS del Bot Interactivo y del Carrusel de Testimoniales -->
	<script>
		// 1. Carusel Logic
		let currentIndex = 0;
		const track = document.getElementById('carousel-track');
		const slides = track ? track.children : [];
		const totalSlides = slides.length;
		const dots = document.querySelectorAll('.carousel-dot');

		function updateCarousel(index: number) {
			if (!track) return;
			currentIndex = (index + totalSlides) % totalSlides;
			track.style.transform = `translateX(-${currentIndex * 100}%)`;
			
			// Update dots
			dots.forEach((dot, idx) => {
				if (idx === currentIndex) {
					dot.classList.add('bg-orange-500', 'w-4');
					dot.classList.remove('bg-white/20');
				} else {
					dot.classList.remove('bg-orange-500', 'w-4');
					dot.classList.add('bg-white/20');
				}
			});
		}

		document.getElementById('prev-slide')?.addEventListener('click', () => {
			updateCarousel(currentIndex - 1);
		});

		document.getElementById('next-slide')?.addEventListener('click', () => {
			updateCarousel(currentIndex + 1);
		});

		dots.forEach(dot => {
			dot.addEventListener('click', (e) => {
				const idx = parseInt((e.target as HTMLElement).getAttribute('data-index') || '0');
				updateCarousel(idx);
			});
		});

		// Inicializar carrusel
		updateCarousel(0);

		// 2. Chatbot Logic
		const chatToggle = document.getElementById('chat-toggle');
		const chatWindow = document.getElementById('chat-window');
		const closeChat = document.getElementById('close-chat');
		const chatInput = document.getElementById('chat-input') as HTMLInputElement;
		const sendBtn = document.getElementById('send-btn');
		const chatMessages = document.getElementById('chat-messages');
		const quickReplies = document.querySelectorAll('.quick-reply');

		const botResponses: Record<string, string> = {
			"cotizar proyecto": "¡Excelente! Para cotizar un proyecto, cuéntanos qué necesitas construir (Web, App Móvil o Automatización IA). También puedes agendar directamente en nuestro enlace de Calendly en la sección de contacto.",
			"tecnologías": "Trabajamos con tecnologías de alta fiabilidad y rendimiento: Laravel, PHP, Vue.js, Nuxt.js, PostgreSQL, MySQL, Supabase, APIs RESTful y maquetación con HTML, CSS, JavaScript y Bootstrap.",
			"¿quiénes somos?": "Somos Capitask, una compañía de desarrollo de software a medida y automatizaciones con IA enfocada en construir plataformas web robustas y escalables.",
			"default": "¡Entendido! Si tienes requerimientos específicos de desarrollo, por favor escríbenos directamente a hola@capitask.com o agenda una reunión en la sección inferior de contacto."
		};

		function toggleChat() {
			if (chatWindow.classList.contains('hidden')) {
				chatWindow.classList.remove('hidden');
				setTimeout(() => {
					chatWindow.classList.remove('translate-y-4', 'opacity-0');
				}, 50);
			} else {
				chatWindow.classList.add('translate-y-4', 'opacity-0');
				setTimeout(() => {
					chatWindow.classList.add('hidden');
				}, 300);
			}
		}

		function appendMessage(text: string, isUser: boolean) {
			const messageDiv = document.createElement('div');
			if (isUser) {
				messageDiv.className = "bg-orange-500 text-slate-950 font-semibold rounded-2xl rounded-tr-none p-3 max-w-[85%] self-end";
			} else {
				messageDiv.className = "bg-white/5 border border-white/5 rounded-2xl rounded-tl-none p-3 max-w-[85%] text-slate-300";
			}
			messageDiv.textContent = text;
			chatMessages.appendChild(messageDiv);
			chatMessages.scrollTop = chatMessages.scrollHeight;
		}

		function handleSend(text: string) {
			if (!text.trim()) return;
			appendMessage(text, true);

			// Generar respuesta del bot simulada
			setTimeout(() => {
				const query = text.toLowerCase().trim();
				let response = botResponses.default;
				
				for (const key in botResponses) {
					if (query.includes(key)) {
						response = botResponses[key];
						break;
					}
				}
				appendMessage(response, false);
			}, 600);
		}

		chatToggle.addEventListener('click', toggleChat);
		closeChat.addEventListener('click', toggleChat);
		
		sendBtn.addEventListener('click', () => {
			handleSend(chatInput.value);
			chatInput.value = '';
		});

		chatInput.addEventListener('keypress', (e) => {
			if (e.key === 'Enter') {
				handleSend(chatInput.value);
				chatInput.value = '';
			}
		});

		quickReplies.forEach(btn => {
			btn.addEventListener('click', () => {
				handleSend(btn.textContent || '');
			});
		});
	</script>

	<!-- Footer -->
	<footer class="border-t border-white/5 py-16 bg-slate-950/80 backdrop-blur-md">
		<div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
			<div class="flex items-center gap-3">
				<img src="/logoss.png" alt="Capitask Logo" class="h-12 w-auto object-contain" />
			</div>
			<div class="flex gap-8 text-sm text-slate-400">
				<a href="#" class="hover:text-orange-400 transition-colors">Privacidad</a>
				<a href="#" class="hover:text-orange-400 transition-colors">Términos de Servicio</a>
				<a href="#" class="hover:text-orange-400 transition-colors">Contacto</a>
			</div>
		</div>
	</footer>
</Layout>
